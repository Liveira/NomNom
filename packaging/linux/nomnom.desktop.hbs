[Desktop Entry]
Type=Application
Version=1.0
Name=NomNom
GenericName=Utility Hub
Comment=Downloads, file converter, folder organizer and disk space analyzer
Exec={{exec}} %U
Icon={{icon}}
Terminal=false
Categories=Utility;FileTools;Archiving;AudioVideo;
MimeType=inode/directory;
StartupWMClass=nomnom
Keywords=download;yt-dlp;convert;ffmpeg;organize;disk;storage;treesize;space;
Actions=AnalyzeDisk;QuickDownload;Background;

[Desktop Action AnalyzeDisk]
Name=Analyze disk space with NomNom
Exec={{exec}} --shell-action analyze -- %F
Icon={{icon}}

[Desktop Action QuickDownload]
Name=Quick download from clipboard
Exec={{exec}} --quick
Icon={{icon}}

[Desktop Action Background]
Name=Start in system tray
Exec={{exec}} --background
Icon={{icon}}
