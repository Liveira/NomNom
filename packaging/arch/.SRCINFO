pkgbase = nomnom
	pkgdesc = Local utility hub: media downloader, file converter, folder organizer and disk space analyzer
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/Liveira/NomNom
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = nodejs
	makedepends = npm
	makedepends = pkgconf
	makedepends = rust
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libayatana-appindicator
	depends = webkit2gtk-4.1
	optdepends = yt-dlp: download video and audio in Downloader (or install inside Settings -> Tools)
	optdepends = ffmpeg: merge streams and convert audio/video in File Tools
	optdepends = libreoffice-fresh: convert Word, Excel and PowerPoint files to PDF
	optdepends = polkit: run elevated root scans in Disk Analyzer via pkexec
	optdepends = tar: unpack managed FFmpeg builds
	optdepends = xz: unpack managed FFmpeg builds
	options = !lto

pkgname = nomnom
