{
  "manifest_version": 3,
  "name": "NomNom",
  "version": "0.1.2",
  "description": "Adds a download button to videos and posts. Sends links to the NomNom app on this computer.",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nomnom@nomnom.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.instagram.com/*",
    "https://www.reddit.com/*",
    "https://*.tiktok.com/*",
    "https://*.vimeo.com/*",
    "https://*.twitch.tv/*",
    "https://*.dailymotion.com/*",
    "https://*.facebook.com/*",
    "https://*.bilibili.com/*",
    "https://*.streamable.com/*",
    "https://*.bsky.app/*",
    "https://*.tumblr.com/*",
    "https://*.pinterest.com/*",
    "https://*.imgur.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content-x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content-instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "content-reddit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.vimeo.com/*",
        "https://*.twitch.tv/*",
        "https://*.dailymotion.com/*",
        "https://*.facebook.com/*",
        "https://*.bilibili.com/*",
        "https://*.streamable.com/*",
        "https://*.bsky.app/*",
        "https://*.tumblr.com/*",
        "https://*.pinterest.com/*",
        "https://*.imgur.com/*"
      ],
      "js": [
        "content-generic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "NomNom",
    "default_popup": "options.html"
  }
}
